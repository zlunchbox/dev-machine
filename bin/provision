#!/usr/bin/env bash
set -euo pipefail

# ── Formatting ───────────────────────────────────────────────────────────────

BOLD='\033[1m'
DIM='\033[2m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

step() { echo -e "\n  ${BOLD}${CYAN}$*${NC}"; }
ok()   { echo -e "  ${GREEN}✓${NC}  $*"; }

# ── Terraform ─────────────────────────────────────────────────────────────────

step "Applying Terraform..."
cd "$ROOT_DIR/terraform"
terraform apply

IP="$(terraform output -raw instance_public_ip)"
ok "Instance IP: $IP"

# ── Ansible ───────────────────────────────────────────────────────────────────

step "Running Ansible..."
cd "$ROOT_DIR/ansible"
uv run ansible-playbook -i "$IP," playbook.yml

echo
ok "Done. Connect with:"
echo -e "\n  ${DIM}$(cd "$ROOT_DIR/terraform" && terraform output -raw ssh_command)${NC}\n"
